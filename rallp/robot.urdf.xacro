<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rallp-0000">
  <!-- Common -->
  <xacro:include filename="$(find rallp_platform_description)/urdf/common.urdf.xacro"/>
  <!-- Platform -->
  <xacro:include filename="$(find rallp_platform_description)/urdf/rallp/rallp.urdf.xacro"/>
  <xacro:rallp control="diff_4wd" front_wheels="outdoor" rear_wheels="outdoor"/>
  <!-- Attachments -->
  <!-- Links -->
  <!-- Mounts -->
  <!-- Sensors -->
  <!-- lidar2d_0 -->
  <xacro:include filename="$(find rallp_sensors_description)/urdf/hokuyo_ust.urdf.xacro"/>
  <xacro:hokuyo_ust name="lidar2d_0" parent_link="chassis_link" ang_res="0.5" min_ang="-3.141592653589793" max_ang="3.141592653589793" min_range="0.05" max_range="25.0" update_rate="40">
    <origin xyz="0.17447 0.0 0.27675" rpy="0.0 0.0 0.0"/>
  </xacro:hokuyo_ust>
  <!-- imu_0 -->
  <xacro:include filename="$(find rallp_sensors_description)/urdf/phidgets_spatial.urdf.xacro"/>
  <xacro:phidgets_spatial name="imu_0" parent_link="base_link">
    <origin xyz="0.059 0.0 0.161275" rpy="0.0 0.0 0.0"/>
  </xacro:phidgets_spatial>
  <!-- camera_0 -->
  <xacro:include filename="$(find rallp_sensors_description)/urdf/rgb_camera.urdf.xacro"/>
  <xacro:rgb_camera name="camera_0" parent_link="chassis_link" update_rate="30" width="640" height="480" fov="1.047">
    <!-- Same position as lidar2d_0, slightly offset in Y to avoid collision -->
    <origin xyz="0.17447 0.05 0.27675" rpy="0.0 0.0 0.0"/>
  </xacro:rgb_camera>
  <!-- Manipulators -->
  <!-- Extras -->
</robot>
