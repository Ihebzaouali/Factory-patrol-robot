<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="rallp_drivetrain_wheels" params="front_wheels rear_wheels">

    <xacro:include filename="$(find rallp_platform_description)/urdf/rallp/drivetrain/wheels/outdoor.urdf.xacro" />
    
    
    <xacro:include filename="$(find rallp_platform_description)/urdf/rallp/drivetrain/motor.urdf.xacro" />
    <xacro:include filename="$(find rallp_platform_description)/urdf/rallp/drivetrain/caster_flange.urdf.xacro" />

    <!-- Front Wheels -->
    <xacro:if value="${front_wheels == 'outdoor'}">
      <xacro:property name="front_wheel_radius" value="${rallp_outdoor_wheel_radius}" scope="parent"/>
      <xacro:property name="front_wheel_width" value="${rallp_outdoor_wheel_width}" scope="parent"/>

      <!-- Motors -->
      <xacro:rallp_motor prefix="front" side="left"/>
      <xacro:rallp_motor prefix="front" side="right"/>

      <!-- Wheels -->
      <xacro:rallp_outdoor_wheel prefix="front" side="left"/>
      <xacro:rallp_outdoor_wheel prefix="front" side="right"/>

    </xacro:if>

    <xacro:if value="${front_wheels == 'mecanum'}">
      <xacro:property name="front_wheel_radius" value="${rallp_mecanum_wheel_radius}" scope="parent"/>
      <xacro:property name="front_wheel_width" value="${rallp_mecanum_wheel_width}" scope="parent"/>

      <!-- Motors -->
      <xacro:rallp_motor prefix="front" side="left"/>
      <xacro:rallp_motor prefix="front" side="right"/>

      <!-- Wheels -->
      <xacro:rallp_mecanum_wheel prefix="front" side="left"/>
      <xacro:rallp_mecanum_wheel prefix="front" side="right"/>

    </xacro:if>

    <xacro:if value="${front_wheels == 'caster'}">
      <xacro:property name="front_wheel_radius" value="${rallp_caster_wheel_radius}" scope="parent"/>
      <xacro:property name="front_wheel_width" value="${rallp_caster_wheel_width}" scope="parent"/>

      <!-- Flanges -->
      <xacro:rallp_caster_flange prefix="front" side="left"/>
      <xacro:rallp_caster_flange prefix="front" side="right"/>

      <!-- Wheels -->
      <xacro:rallp_caster_wheel prefix="front" side="left"/>
      <xacro:rallp_caster_wheel prefix="front" side="right"/>

    </xacro:if>

    <!-- Rear Wheels -->
    <xacro:if value="${rear_wheels == 'outdoor'}">
      <xacro:property name="rear_wheel_radius" value="${rallp_outdoor_wheel_radius}" scope="parent"/>
      <xacro:property name="rear_wheel_width" value="${rallp_outdoor_wheel_width}" scope="parent"/>

      <!-- Motors -->
      <xacro:rallp_motor prefix="rear" side="left"/>
      <xacro:rallp_motor prefix="rear" side="right"/>

      <!-- Wheels -->
      <xacro:rallp_outdoor_wheel prefix="rear" side="left"/>
      <xacro:rallp_outdoor_wheel prefix="rear" side="right"/>

    </xacro:if>

    <xacro:if value="${rear_wheels == 'mecanum'}">
      <xacro:property name="rear_wheel_radius" value="${rallp_mecanum_wheel_radius}" scope="parent"/>
      <xacro:property name="rear_wheel_width" value="${rallp_mecanum_wheel_width}" scope="parent"/>

      <!-- Motors -->
      <xacro:rallp_motor prefix="rear" side="left"/>
      <xacro:rallp_motor prefix="rear" side="right"/>

      <!-- Wheels -->
      <xacro:rallp_mecanum_wheel prefix="rear" side="left"/>
      <xacro:rallp_mecanum_wheel prefix="rear" side="right"/>

    </xacro:if>

    <xacro:if value="${rear_wheels == 'caster'}">
      <xacro:property name="rear_wheel_radius" value="${rallp_caster_wheel_radius}" scope="parent"/>
      <xacro:property name="rear_wheel_width" value="${rallp_caster_wheel_width}" scope="parent"/>

      <!-- Flanges -->
      <xacro:rallp_caster_flange prefix="rear" side="left"/>
      <xacro:rallp_caster_flange prefix="rear" side="right"/>

      <!-- Wheels -->
      <xacro:rallp_caster_wheel prefix="rear" side="left"/>
      <xacro:rallp_caster_wheel prefix="rear" side="right"/>

    </xacro:if>

  </xacro:macro>
</robot>
