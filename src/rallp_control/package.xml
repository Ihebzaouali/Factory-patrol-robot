<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rallp_control</name>
  <version>2.7.4</version>
  <description>Controllers for Rallp</description>
  <maintainer email="mohamedalizouari.ai@mail.ru">Mohamed Ali Zouari</maintainer>


  <license>BSD</license>
  <author email="mohamedalizouari.ai@mail.ru">Mohamed Ali Zouari</author>


  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rallp_bt_joy</exec_depend>
